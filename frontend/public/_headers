# Security headers for the website. Netlify and Cloudflare Pages read this file as it is;
# for nginx, Apache or anything else see docs/HOSTING_SECURITY.md (the same headers, written for them).
# Do not add a Content-Security-Policy here until you have tried it in report-only mode: see the document.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=31536000, immutable
